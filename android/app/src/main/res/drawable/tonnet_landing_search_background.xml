<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tonnet_surface_dim" />
            <stroke
                android:width="1dp"
                android:color="@color/tonnet_accent" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tonnet_surface_dim" />
            <stroke
                android:width="1dp"
                android:color="@color/tonnet_divider" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
