<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext (HTTP) traffic by default.
         External clearnet must use HTTPS; unsecure HTTP links are blocked. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Scoped exception: the local tonutils-proxy and TON domains it serves are HTTP-only.
         Encryption for .ton/.adnl traffic is handled end-to-end by the ADNL tunnel,
         below the WebView transport layer. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">ton</domain>
        <domain includeSubdomains="true">adnl</domain>
    </domain-config>
</network-security-config>
