+func waitForRouteRetry(ctx context.Context, routeErr error, delay time.Duration) bool {
+	if ctx.Err() != nil {
+		return false
+	}
+	if errors.Is(routeErr, ErrNoMoreRoutes) || errors.Is(routeErr, ErrRouteIsNotAccepted) {
+		return true
+	}
+
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
+
 var ErrRouteCanceled = errors.New("route canceled")
 var ErrRouteIsNotAccepted = errors.New("route is not accepted")
 var ErrNoMoreRoutes = errors.New("no more routes to try")
