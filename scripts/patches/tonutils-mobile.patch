+func canonicalTONHost(rawHost string) (string, bool) {
+	host := strings.TrimSpace(strings.ToLower(rawHost))
+	if host == "" || len(host) > 253 {
+		return "", false
+	}
+
+	if parsedHost, port, err := net.SplitHostPort(host); err == nil {
+		if port != "80" {
+			return "", false
+		}
+		host = parsedHost
+	} else if strings.Contains(host, ":") {
+		return "", false
+	}
+
+	host = strings.TrimSuffix(host, ".")
+	if net.ParseIP(host) != nil {
+		return "", false
+	}
+
+	var name string
+	switch {
+	case strings.HasSuffix(host, ".ton"):
+		name = strings.TrimSuffix(host, ".ton")
+	case strings.HasSuffix(host, ".adnl"):
+		name = strings.TrimSuffix(host, ".adnl")
+	case strings.HasSuffix(host, ".t.me"):
+		name = strings.TrimSuffix(host, ".t.me")
+	default:
+		return "", false
+	}
+	if name == "" {
+		return "", false
+	}
+
+	for _, label := range strings.Split(name, ".") {
+		if label == "" || len(label) > 63 {
+			return "", false
+		}
+		for _, char := range label {
+			if !((char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '-' || char == '_') {
+				return "", false
+			}
+		}
+	}
+	return host, true
+}
+
+func applyPrivacyHeaders(header http.Header) {
+	for name := range header {
+		if strings.HasPrefix(strings.ToLower(name), "sec-ch-") {
+			header.Del(name)
+		}
+	}
+	for _, name := range []string{
+		"Device-Memory",
+		"Downlink",
+		"DPR",
+		"ECT",
+		"RTT",
+		"Save-Data",
+		"Viewport-Width",
+		"Width",
+		"X-Requested-With",
+		"X-Tonutils-Proxy",
+	} {
+		header.Del(name)
+	}
+	header.Del("Referer")
+	header.Set("DNT", "1")
+	header.Set("Sec-GPC", "1")
+}
